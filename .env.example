# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For local development with Docker Compose:
DATABASE_URL=postgresql://beaver_user:beaver_password_change_in_production@postgres:5432/beaver_research

# For production (use secrets manager instead):
# DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/beaver_research

# ============================================
# API KEYS (Store in AWS Secrets Manager/Vault for production)
# ============================================
# OpenAI API Key for AI-powered research reports
OPENAI_API_KEY=your_openai_api_key_here

# FRED API Key for macroeconomic data
FRED_API_KEY=your_fred_api_key_here

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# JWT Secret Key - Generate a strong random key for production
# Example: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# OBJECT STORAGE (MinIO/S3)
# ============================================
# For local development with MinIO:
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reports
MINIO_USE_SSL=false

# For production with AWS S3:
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET=your-production-bucket

# ============================================
# APPLICATION SETTINGS
# ============================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# EXTERNAL API CONFIGURATION
# ============================================
# Rate limiting for external APIs
YAHOO_FINANCE_RATE_LIMIT=100
OPENAI_RATE_LIMIT=50

# ============================================
# CORS ORIGINS (Update for production)
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# ============================================
# PRODUCTION-SPECIFIC SETTINGS
# ============================================
# Uncomment and configure for production deployment
# SENTRY_DSN=your_sentry_dsn_for_error_tracking
# REDIS_URL=redis://your-redis-endpoint:6379
# CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
